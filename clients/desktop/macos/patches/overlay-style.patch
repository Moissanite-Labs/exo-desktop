+.xc-approval-help { margin-top: 10px; font-size: 13px; color: var(--fg-2); }
+.xc-approval-focused { display: none; }
+.xc-gate:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
+.xc-gate:focus-within .xc-approval-unfocused { display: none; }
